# IncidentLens Configuration
PORT=8080
NODE_ENV=development

# Gemini API / Google GenAI Configuration
# Model used: gemini-3.8-flash
# If left empty, IncidentLens uses its high-fidelity autonomous SRE engine.
GEMINI_API_KEY=

# Vertex AI Configuration (Optional)
USE_VERTEX_AI=false
GCP_PROJECT=incidentlens-prod-gcp
GCP_REGION=us-central1

# Slack Incoming Webhook (Optional)
# If left empty, interactive cards render in the embedded web Slack simulator.
SLACK_WEBHOOK_URL=
